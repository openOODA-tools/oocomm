// # oocomm Stream Comparison Engine
//
// Logline: Sovereign two-pointer sorted line comparison engine implementing POSIX comm algorithms.
//
// Setup: Pure algorithmic comparison without dynamic allocation or ambient authority.
//
// Beats:
//   1. Split multiline text streams by newline or NUL delimiters.
//   2. Compare strings lexicographically using byte-order semantics.
//   3. Merge two sorted streams into three distinct output columns.
//   4. Deliver formatted column text and aggregate telemetry metrics.

import "core/comm_types.oo";

pub fn str_cmp(a: String, b: String) -> Int {
    let len_a: Int = chars_len(a);
    let len_b: Int = chars_len(b);
    let min_len: Int = if len_a < len_b { len_a } else { len_b };
    let mut i: Int = 0;

    while i < min_len {
        let ba: Int = byte_at(a, i);
        let bb: Int = byte_at(b, i);
        if ba < bb { return 0 - 1; }
        if ba > bb { return 1; }
        i = i + 1;
    }

    if len_a < len_b { return 0 - 1; }
    if len_a > len_b { return 1; }
    return 0;
}

pub fn check_is_sorted(lines: List[String]) -> Bool {
    let n: Int = list_len(lines);
    if n <= 1 { return true; }
    let mut i: Int = 1;
    while i < n {
        let prev: String = list_get(lines, i - 1);
        let curr: String = list_get(lines, i);
        if str_cmp(prev, curr) > 0 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn split_records(content: String, zero_term: Bool) -> List[String] {
    let mut res: List[String] = list_new();
    let n: Int = chars_len(content);
    if n == 0 { return res; }

    let target_byte: Int = if zero_term { 0 } else { 10 };
    let mut start: Int = 0;
    let mut i: Int = 0;

    while i < n {
        if byte_at(content, i) == target_byte {
            let line: String = str_slice(content, start, i);
            res = list_push(res, line);
            start = i + 1;
        }
        i = i + 1;
    }

    if start < n {
        let line: String = str_slice(content, start, n);
        res = list_push(res, line);
    }

    return res;
}

pub fn compare_sorted_streams(
    lines1: List[String],
    lines2: List[String],
    opts: CommOpts
) -> CommResult {
    let mut items: List[CommItem] = list_new();
    let mut stats: CommStats = make_comm_stats();
    let mut out: String = "";

    let col1_pfx: String = "";
    let col2_pfx: String = if opts.suppress_col1 { "" } else { opts.delimiter };
    let col3_pfx: String = if opts.suppress_col1 && opts.suppress_col2 {
        ""
    } else if opts.suppress_col1 || opts.suppress_col2 {
        opts.delimiter
    } else {
        opts.delimiter + opts.delimiter
    };

    let line_end: String = if opts.zero_terminated {
        bytes_to_str(bytes_push(bytes_new(), 0))
    } else {
        "\n"
    };

    let len1: Int = list_len(lines1);
    let len2: Int = list_len(lines2);
    let mut i: Int = 0;
    let mut j: Int = 0;

    while i < len1 && j < len2 {
        let l1: String = list_get(lines1, i);
        let l2: String = list_get(lines2, j);
        let c: Int = str_cmp(l1, l2);

        if c == 0 {
            // Common to both (Col 3)
            items = list_push(items, make_comm_item(l1, 3));
            stats.common_col3 = stats.common_col3 + 1;
            if !opts.suppress_col3 {
                out = out + col3_pfx + l1 + line_end;
            }
            i = i + 1;
            j = j + 1;
        } else if c < 0 {
            // Unique to file1 (Col 1)
            items = list_push(items, make_comm_item(l1, 1));
            stats.unique_col1 = stats.unique_col1 + 1;
            if !opts.suppress_col1 {
                out = out + col1_pfx + l1 + line_end;
            }
            i = i + 1;
        } else {
            // Unique to file2 (Col 2)
            items = list_push(items, make_comm_item(l2, 2));
            stats.unique_col2 = stats.unique_col2 + 1;
            if !opts.suppress_col2 {
                out = out + col2_pfx + l2 + line_end;
            }
            j = j + 1;
        }
    }

    while i < len1 {
        let l1: String = list_get(lines1, i);
        items = list_push(items, make_comm_item(l1, 1));
        stats.unique_col1 = stats.unique_col1 + 1;
        if !opts.suppress_col1 {
            out = out + col1_pfx + l1 + line_end;
        }
        i = i + 1;
    }

    while j < len2 {
        let l2: String = list_get(lines2, j);
        items = list_push(items, make_comm_item(l2, 2));
        stats.unique_col2 = stats.unique_col2 + 1;
        if !opts.suppress_col2 {
            out = out + col2_pfx + l2 + line_end;
        }
        j = j + 1;
    }

    stats.total_lines = stats.unique_col1 + stats.unique_col2 + stats.common_col3;

    if opts.show_total {
        out = out + to_string(stats.unique_col1) + opts.delimiter + to_string(stats.unique_col2) + opts.delimiter + to_string(stats.common_col3) + opts.delimiter + "total" + line_end;
    }

    return make_comm_result(items, stats, out);
}
