// # oocomm Root Subsystem Anchor
//
// Logline: Unified verification anchor certifying sorted line comparison, visual cards, and stdio IPC.
//
// Setup: Executes complete subsystem assertions across merge algorithms, terminal rendering, and JSON-RPC.
//
// Beats:
//   1. Re-export and verify core sorted stream comparison engine.
//   2. Re-export and verify terminal summary cards and JSON telemetry.
//   3. Re-export and verify JSON-RPC stdio IPC protocol subsystem.
//   4. Supply top-level verification suite predicate.

import "core/anchor.oo";
import "render/anchor.oo";
import "ipc/anchor.oo";

pub fn verify_all_subsystems(fs: &FsReadCap) -> Bool {
    if !verify_core_subsystem() {
        return false;
    }

    if !verify_render_subsystem() {
        return false;
    }

    if !verify_ipc_subsystem(fs) {
        return false;
    }

    return true;
}
